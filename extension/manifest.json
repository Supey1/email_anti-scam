{
  "manifest_version": 3,
  "name": "Granblock",
  "version": "0.6.0",
  "description": "Protects older adults from scam emails, fake websites, and risky links with a big, plain-language warning.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "unlimitedStorage",
    "scripting",
    "tts"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://data.phishtank.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Granblock",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui/warning.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
