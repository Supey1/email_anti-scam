{
  "manifest_version": 3,
  "name": "Email Anti-Scam",
  "version": "0.6.0",
  "description": "Helps older adults avoid scams: checks emails, websites, and links, and stops risky clicks with a big, plain-language warning.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_page": "settings.html",
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "Email Anti-Scam",
    "default_popup": "ui/popup.html"
  }
}
