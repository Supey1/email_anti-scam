{
  "manifest_version": 3,
  "name": "Email Anti-Scam",
  "version": "0.5.0",
  "description": "Protects older adults from scam emails, fake websites, and risky links with a big, plain-language warning.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "settings.js",
        "rules.js",
        "threats.js",
        "analyzer.js",
        "panel-styles.js",
        "ui/explain.js",
        "ui/warning-view.js",
        "panel.js",
        "content/ad-signals.js",
        "content/gmail-adapter.js",
        "content/gmail.js",
        "content/click-guard.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "settings.js",
        "rules.js",
        "threats.js",
        "analyzer.js",
        "panel-styles.js",
        "ui/explain.js",
        "ui/warning-view.js",
        "panel.js",
        "content/ad-signals.js",
        "content/page-scanner.js",
        "page.js",
        "content/click-guard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui/warning.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "Email Anti-Scam",
    "default_popup": "ui/popup.html"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  }
}
